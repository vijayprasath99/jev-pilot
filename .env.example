# JevPilot Configuration — JEV & Clef System One Decision Model
# Works with TypeSafe AI Jev or Cloudflare Clef (e.g., clef-flash, clef-flash@bf16, clef-flash@q8_0)

PORT=3000

# Endpoint exposing the System One API (/v1/systemone)
JEV_ENDPOINT=http://localhost:1234/v1/systemone

# Model Identifier: e.g. "clef-flash", "clef-flash@bf16", "clef", or "jev"
JEV_MODEL=clef-flash

# Optional API Key (if required by your endpoint)
JEV_API_KEY=your-api-key-here
